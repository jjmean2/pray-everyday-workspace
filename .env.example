# 로컬 개발용 기본값. 복사해서 .env로 쓴다. .env는 커밋하지 않는다.
POSTGRES_USER=pray
POSTGRES_PASSWORD=pray
POSTGRES_DB=pray_everyday
POSTGRES_PORT=5432
DATABASE_URL=postgres://pray:pray@localhost:5432/pray_everyday
# 개발용 로그인(로컬 개발과 자동 테스트 전용). 운영 환경에서 켜면 서버가 시작하지 않는다
DEV_LOGIN=true
# 로컬 개발(http://localhost)에서만 세션 쿠키의 Secure를 끈다. 운영 환경에서 끄면 서버가 시작하지 않는다
COOKIE_SECURE=false
# 소셜 로그인. 콜백 주소는 OAUTH_REDIRECT_BASE + /auth/{kakao|google}/callback 이고, 카카오와 구글 콘솔에 같은 주소를 등록한다.
# 키가 비어 있는 제공자로는 로그인할 수 없다(개발용 로그인은 그대로 쓸 수 있다). 운영 환경에서는 모두 있어야 서버가 시작한다
OAUTH_REDIRECT_BASE=http://localhost:6102/api
# 카카오 디벨로퍼스의 REST API 키와 Client Secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 구글 Cloud 콘솔(Google Auth Platform)의 OAuth 클라이언트 ID와 보안 비밀번호
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
