# 로컬 개발용 기본값. 복사해서 .env로 쓴다. .env는 커밋하지 않는다.
POSTGRES_USER=pray
POSTGRES_PASSWORD=pray
POSTGRES_DB=pray_everyday
POSTGRES_PORT=5432
DATABASE_URL=postgres://pray:pray@localhost:5432/pray_everyday
# 개발용 로그인(로컬 개발과 자동 테스트 전용). 운영 환경에서 켜면 서버가 시작하지 않는다
DEV_LOGIN=true
# 로컬 개발(http://localhost)에서만 세션 쿠키의 Secure를 끈다. 운영 환경에서 끄면 서버가 시작하지 않는다
COOKIE_SECURE=false
