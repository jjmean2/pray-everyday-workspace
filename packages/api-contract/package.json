{
  "name": "@pray/api-contract",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.yaml": "./openapi.yaml"
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o src/generated/schema.ts",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "check-types": "pnpm generate && tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  }
}
