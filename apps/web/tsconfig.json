{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    // TanStack Start 권장: 켜면 서버 번들이 클라이언트 번들에 섞일 수 있다
    "verbatimModuleSyntax": false,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
